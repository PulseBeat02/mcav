{
  "targets": {
    "swap": {},
    "mcav:mcv2_screen": {},
    "mcav:mcv2_outline": {}
  },
  "screen_targets": {
    "mcav:mcv2_bytes_@S@": {
      "width": @BYTES_WIDTH@,
      "height": @BYTES_HEIGHT@
    },
    "mcav:mcv2_crc_@S@": {
      "width": @CRC_WIDTH@,
      "height": 1
    },
    "mcav:mcv2_pages_@S@": {
      "width": @PAGES_WIDTH@,
      "height": 1
    },
    "mcav:mcv2_status_@S@": {
      "width": 4,
      "height": 1
    },
    "mcav:mcv2_state_@S@": {
      "width": 4,
      "height": 1,
      "persistent": true
    },
    "mcav:mcv2_state_next_@S@": {
      "width": 4,
      "height": 1
    },
    "mcav:mcv2_cells_@S@": {
      "width": @CELLS_WIDTH@,
      "height": @CELLS_HEIGHT@
    },
    "mcav:mcv2_previous_@S@": {
      "width": @VIDEO_WIDTH@,
      "height": @VIDEO_HEIGHT@,
      "persistent": true
    },
    "mcav:mcv2_key_@S@": {
      "width": @VIDEO_WIDTH@,
      "height": @VIDEO_HEIGHT@,
      "persistent": true
    },
    "mcav:mcv2_next_@S@": {
      "width": @VIDEO_WIDTH@,
      "height": @VIDEO_HEIGHT@
    },
    "mcav:mcv2_key_next_@S@": {
      "width": @VIDEO_WIDTH@,
      "height": @VIDEO_HEIGHT@
    },
    "mcav:mcv2_view_@S@": {
      "width": 31,
      "height": 1
    }
  },
  "decode": [
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/s@S@/mcv2_bytes",
      "inputs": [
        {
          "sampler_name": "Main",
          "target": "minecraft:main"
        }
      ],
      "output": "mcav:mcv2_bytes_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/s@S@/mcv2_crc",
      "inputs": [
        {
          "sampler_name": "Main",
          "target": "minecraft:main"
        }
      ],
      "output": "mcav:mcv2_crc_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/s@S@/mcv2_pages",
      "inputs": [
        {
          "sampler_name": "Main",
          "target": "minecraft:main"
        },
        {
          "sampler_name": "Crc",
          "target": "mcav:mcv2_crc_@S@"
        }
      ],
      "output": "mcav:mcv2_pages_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/s@S@/mcv2_status",
      "inputs": [
        {
          "sampler_name": "Pages",
          "target": "mcav:mcv2_pages_@S@"
        },
        {
          "sampler_name": "State",
          "target": "mcav:mcv2_state_@S@"
        }
      ],
      "output": "mcav:mcv2_status_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/s@S@/mcv2_resolve",
      "inputs": [
        {
          "sampler_name": "Bytes",
          "target": "mcav:mcv2_bytes_@S@"
        },
        {
          "sampler_name": "Status",
          "target": "mcav:mcv2_status_@S@"
        },
        {
          "sampler_name": "Previous",
          "target": "mcav:mcv2_previous_@S@"
        }
      ],
      "output": "mcav:mcv2_cells_@S@"
    },
    {
      "vertex_shader": "mcav:post/s@S@/mcv2_decode",
      "fragment_shader": "mcav:post/s@S@/mcv2_decode",
      "inputs": [
        {
          "sampler_name": "Bytes",
          "target": "mcav:mcv2_bytes_@S@"
        },
        {
          "sampler_name": "Status",
          "target": "mcav:mcv2_status_@S@"
        },
        {
          "sampler_name": "Cells",
          "target": "mcav:mcv2_cells_@S@"
        },
        {
          "sampler_name": "Previous",
          "target": "mcav:mcv2_previous_@S@"
        },
        {
          "sampler_name": "Key",
          "target": "mcav:mcv2_key_@S@"
        }
      ],
      "output": "mcav:mcv2_next_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/mcv2_copy",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "mcav:mcv2_next_@S@"
        }
      ],
      "output": "mcav:mcv2_previous_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/mcv2_keyframe",
      "inputs": [
        {
          "sampler_name": "Next",
          "target": "mcav:mcv2_next_@S@"
        },
        {
          "sampler_name": "Key",
          "target": "mcav:mcv2_key_@S@"
        },
        {
          "sampler_name": "Status",
          "target": "mcav:mcv2_status_@S@"
        }
      ],
      "output": "mcav:mcv2_key_next_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/mcv2_copy",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "mcav:mcv2_key_next_@S@"
        }
      ],
      "output": "mcav:mcv2_key_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/mcv2_state",
      "inputs": [
        {
          "sampler_name": "State",
          "target": "mcav:mcv2_state_@S@"
        },
        {
          "sampler_name": "Status",
          "target": "mcav:mcv2_status_@S@"
        }
      ],
      "output": "mcav:mcv2_state_next_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/mcv2_copy",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "mcav:mcv2_state_next_@S@"
        }
      ],
      "output": "mcav:mcv2_state_@S@"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/s@S@/mcv2_view",
      "inputs": [
        {
          "sampler_name": "Main",
          "target": "minecraft:main"
        },
        {
          "sampler_name": "State",
          "target": "mcav:mcv2_state_@S@"
        }
      ],
      "output": "mcav:mcv2_view_@S@"
    }
  ],
  "draw": [
    {
      "vertex_shader": "mcav:post/s@S@/mcv2_screen",
      "fragment_shader": "mcav:post/s@S@/mcv2_screen",
      "inputs": [
        {
          "sampler_name": "Main",
          "target": "minecraft:main"
        },
        {
          "sampler_name": "MainDepth",
          "target": "minecraft:main",
          "use_depth_buffer": true
        },
        {
          "sampler_name": "Picture",
          "target": "mcav:mcv2_previous_@S@"
        },
        {
          "sampler_name": "State",
          "target": "mcav:mcv2_state_@S@"
        },
        {
          "sampler_name": "Pages",
          "target": "mcav:mcv2_pages_@S@"
        },
        {
          "sampler_name": "Status",
          "target": "mcav:mcv2_status_@S@"
        },
        {
          "sampler_name": "View",
          "target": "mcav:mcv2_view_@S@"
        }
      ],
      "output": "mcav:mcv2_screen"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/mcv2_copy",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "mcav:mcv2_screen"
        }
      ],
      "output": "minecraft:main"
    }
  ],
  "tail": [
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/mcv2_outline",
      "inputs": [
        {
          "sampler_name": "Outline",
          "target": "minecraft:entity_outline"
        }
      ],
      "output": "mcav:mcv2_outline"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "mcav:post/mcv2_copy",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "mcav:mcv2_outline"
        }
      ],
      "output": "minecraft:entity_outline"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/entity_sobel",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "minecraft:entity_outline"
        }
      ],
      "output": "swap"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/entity_outline_box_blur",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "swap",
          "bilinear": true
        }
      ],
      "output": "minecraft:entity_outline",
      "uniforms": {
        "BlurConfig": [
          {
            "name": "BlurDir",
            "type": "vec2",
            "value": [
              1.0,
              0.0
            ]
          },
          {
            "name": "Radius",
            "type": "float",
            "value": 2.0
          }
        ]
      }
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/entity_outline_box_blur",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "minecraft:entity_outline",
          "bilinear": true
        }
      ],
      "output": "swap",
      "uniforms": {
        "BlurConfig": [
          {
            "name": "BlurDir",
            "type": "vec2",
            "value": [
              0.0,
              1.0
            ]
          },
          {
            "name": "Radius",
            "type": "float",
            "value": 2.0
          }
        ]
      }
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/blit",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "swap"
        }
      ],
      "uniforms": {
        "BlitConfig": [
          {
            "name": "ColorModulate",
            "type": "vec4",
            "value": [
              1.0,
              1.0,
              1.0,
              1.0
            ]
          }
        ]
      },
      "output": "minecraft:entity_outline"
    }
  ]
}
