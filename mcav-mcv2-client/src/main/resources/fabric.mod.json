{
  "schemaVersion": 1,
  "id": "mcav_mcv2",
  "version": "${version}",
  "name": "MCAV MCV2 Client",
  "description": "Decodes MCAV's MCV2 screens under Iris 1.11.7 shader packs. With another Iris version it tells MCAV servers that a shader pack is on, so they show you the dithered maps while it is.",
  "authors": ["Brandon Li"],
  "contact": {
    "homepage": "https://github.com/PulseBeat02/mcav"
  },
  "license": "GPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "client": ["me.brandonli.mcav.client.FabricEntrypoint"]
  },
  "mixins": ["mcav-mcv2.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-networking-api-v1": "*",
    "fabric-lifecycle-events-v1": "*"
  }
}
