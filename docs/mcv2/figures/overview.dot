// MCV2 end to end: from a video frame on the server to a pixel on the player's screen.
// Rendered by render.sh; the style follows the site's other diagrams (library/pipeline.png).
digraph overview {
  rankdir=LR;
  bgcolor="white";
  pad=0.2;
  nodesep=0.3;
  ranksep=0.35;
  newrank=true;
  node [shape=box, style=filled, fillcolor="#f5f5f5", color="#666666", fontname="Arial", fontsize=11, fontcolor="#333333", margin="0.12,0.08"];
  edge [color="#666666", arrowsize=0.7, fontname="Arial", fontsize=10, fontcolor="#555555"];

  subgraph cluster_server {
    label="Minecraft server (mcav-bukkit)";
    fontname="Arial"; fontsize=11; fontcolor="#333333";
    style="rounded"; color="#999999";
    source [label="Video frame\n(file, stream, browser,\nVM, VNC desktop)", fillcolor="#fff2cc", color="#d6b656"];
    encoder [label="Encoder\nblock tree of 32, 16 and 8\npixel blocks, predicted from\nthe previous decoded frame"];
    frame [label="MCV2 frame\n(bytes)", fillcolor="#fff2cc", color="#d6b656"];
    pages [label="Transport\npages of 16,384\nsix-bit symbols,\nCRC32 each"];
    packets [label="Map packets\none map per page,\none bundle per frame"];
    source -> encoder -> frame -> pages -> packets;
  }

  subgraph cluster_client {
    label="Unmodified Minecraft client with the MCV2 resource pack";
    fontname="Arial"; fontsize=11; fontcolor="#333333";
    style="rounded"; color="#999999";
    maps [label="Map textures\n128x128 colour bytes"];
    strip [label="core/text shaders\nmove page maps into\na strip of the screen"];
    chain [label="Post chain\n(entity_outline.json)\nCRC check, resolve,\ndecode, persistent\nreference frames"];
    screen [label="Picture drawn over\nthe wall of maps", fillcolor="#fff2cc", color="#d6b656"];
    maps -> strip -> chain -> screen;
  }

  packets -> maps [label="TCP, zlib"];
}
