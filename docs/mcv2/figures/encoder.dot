// Figure: how the reference search (the ship and low_bandwidth profiles) encodes one frame, in order.
// Mcv2Encoder.begin/finish, GlobalMotion, BlockCoder, FrameWriter; the live presets differ where the note says.
digraph encoder {
  rankdir=TB;
  bgcolor="white";
  pad=0.2;
  nodesep=0.3;
  ranksep=0.28;
  node [shape=box, style=filled, fillcolor="#f5f5f5", color="#666666", fontname="Arial", fontsize=11, fontcolor="#333333", margin="0.12,0.07"];
  edge [color="#666666", arrowsize=0.7, fontname="Arial", fontsize=10, fontcolor="#555555"];

  source [label="Source frame (RGB24)", fillcolor="#fff2cc", color="#d6b656"];
  predictable [shape=diamond, label="Previous decoded frame\nof this size, and fewer than\nkey-interval frames since\nthe keyframe?", margin="0.02,0.02"];
  global [label="Global translation\nphase correlation of the quarter-resolution luma (FFT);\nthen the zero vector and a 7x7 window of whole-pixel vectors\naround the peak, scored on every 12th pixel of every 12th row"];
  cut [shape=diamond, label="Scene cut?\nmean |luma change| after\nglobal prediction > 45", margin="0.02,0.02"];
  key [label="Keyframe\nno temporal leaves"];
  pframe [label="P frame\npredicts from the previous\ndecoded frame"];
  trials [label="Trials\nthe global vector, and the zero vector too when the global\nvector is not zero, each with full and with RGB565 pattern\nendpoints: up to 4 on a P frame, 2 on a keyframe"];
  blocks [label="Every block of every level (32, 16, 8), superblocks in parallel\ncandidates scored against the decoded reference:\ncost = weighted squared error + lambda x bits\n(chart: one block and its modes)"];
  tree [label="For each trial: the tree, bottom up\nsplit where four children and the split's descriptor\ncost less than the best leaf; repeating palettes become patterns"];
  write [label="Write the trial's frame\nderived index, packed symbols, two-level walk,\nendpoint and selector tables"];
  decode [label="Decode the written bytes"];
  compare [shape=diamond, label="Cheaper than the best\ntrial so far?\nsquared error\n+ lambda x 8 x bytes", margin="0.02,0.02"];
  keep [label="Keep this trial"];
  revert [label="Keep the earlier one"];
  more [shape=diamond, label="More trials?", margin="0.02,0.02"];
  verify [label="Verify\nthe bytes describe the chosen tree; every leaf\ndecodes to the error the search measured"];
  reference [label="Decoded picture\nbecomes the reference", fillcolor="#fff2cc", color="#d6b656"];
  out [label="Frame bytes to the transport\n(chart: transport)", fillcolor="#fff2cc", color="#d6b656"];
  live [shape=note, label="Live presets (live, adaptive, live-fast):\none trial, its vector chosen before the search\nby what SKIP costs on a sample; the tree searched\nfrom the top with early SKIP and split thresholds;\na frame too large for the page slots is searched\nagain at twice the lambda, up to four times", fillcolor="#ffffff", color="#999999", fontsize=10];

  source -> predictable;
  predictable -> key [label="no"];
  predictable -> global [label="yes"];
  global -> cut;
  cut -> key [label="yes"];
  cut -> pframe [label="no"];
  key -> trials;
  pframe -> trials;
  trials -> blocks -> tree -> write -> decode -> compare;
  compare -> keep [label="yes"];
  compare -> revert [label="no"];
  keep -> more;
  revert -> more;
  more -> tree [label="yes"];
  more -> verify [label="no"];
  verify -> reference;
  verify -> out;
  reference -> predictable [label="next frame", constraint=false];
  live -> trials [style=dotted, arrowhead=none];
}
