// Figure: what the client does with a frame, from packet arrival to the pixels on the wall: the resource pack's core
// text shaders and its post chain (post_effect/entity_outline.json), with the two persistent reference frames.
// Dashed: what is not verified on a vanilla client (see the warning beside the figure).
digraph decode {
  rankdir=TB;
  bgcolor="white";
  pad=0.2;
  nodesep=0.3;
  ranksep=0.26;
  node [shape=box, style=filled, fillcolor="#f5f5f5", color="#666666", fontname="Arial", fontsize=11, fontcolor="#333333", margin="0.12,0.07"];
  edge [color="#666666", arrowsize=0.7, fontname="Arial", fontsize=10, fontcolor="#555555"];

  arrive [label="Map packets arrive; the maps' textures update", fillcolor="#fff2cc", color="#d6b656"];
  glow [label="A glowing page frame (hidden behind the wall) is drawn,\nso the client runs post_effect/entity_outline.json after the main pass"];
  text [label="core/text shaders: page maps into the strip;\nthe wall's anchor maps write its corners and the projection\ninto a descriptor row"];
  pages [label="Passes 1 to 3: mcv2_bytes, mcv2_crc, mcv2_pages\nevery page slot read back, CRC32 and header checked"];
  status [label="Pass 4: mcv2_status decides for this rendered frame"];
  decide [shape=diamond, label="Every page valid, newer than\nthe last decoded frame, and a\nkeyframe or predicting from a\nreference the client holds?", margin="0.02,0.02"];
  keepold [label="Nothing new, or a frame it cannot decode:\nthe last picture is copied (never a guess)"];
  resolve [label="Pass 5: mcv2_resolve\none fragment per 8x8 cell finds the leaf that covers it\n(chart: finding the leaf of a pixel)"];
  decodepass [label="Pass 6: mcv2_decode\none fragment per pixel reconstructs it from its cell's leaf,\nthe frame's bytes and the reference, quantized to RGB8"];
  previous [label="Pass 7: copy into the persistent target\nmcv2_previous (the previous decoded frame)"];
  iskey [shape=diamond, label="Keyframe?", margin="0.02,0.02"];
  key [label="Pass 8: copy into the persistent\ntarget mcv2_key (the last keyframe)"];
  state [label="Pass 9: mcv2_state (persistent): shown flag,\nlast id, key id, decoded-frame counter"];
  view [label="Pass 10: mcv2_view\nthe anchors' 28 floats, read once per frame"];
  screen [label="Pass 11: mcv2_screen\nray-casts every pixel of the wall's box onto the screen plane,\ndepth-tested against the scene, draws the picture"];
  outline [label="Pass 12: mcv2_outline\nremoves the page frames' glow; vanilla's outline passes follow"];
  shown [label="Picture on the wall", fillcolor="#fff2cc", color="#d6b656"];
  lost [label="A page lost or corrupt (CRC mismatch)", fillcolor="#ffffff"];
  wait [label="Frames predicting from the missed one cannot be\ndecoded: the picture waits for the next keyframe\n(key interval: 2 s for ship, 4 s for live at 30 fps)"];
  unverified [label="Not verified on a vanilla client: the Vulkan backend,\nNVIDIA, AMD and Apple GPUs, Windows and macOS clients;\nDecoder bypass: improved transparency or active Iris shader packs", style="filled,dashed", fillcolor="#ffffff"];

  arrive -> glow -> text -> pages -> status -> decide;
  decide -> keepold [label="no"];
  decide -> resolve [label="yes"];
  resolve -> decodepass -> previous -> iskey;
  iskey -> key [label="yes"];
  iskey -> state [label="no"];
  key -> state;
  keepold -> state;
  state -> view -> screen -> outline -> shown;
  lost -> decide [label="fails the check"];
  decide -> wait [label="next P frames"];
  unverified -> glow [style=dashed, arrowhead=none];
}
