# Editor settings for every file in the mcav repository. Formatting of Java sources is enforced by Spotless as
# well, but these settings keep editors consistent before the formatter runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown keeps the repository default of trimming trailing whitespace, because Spotless trims it too and the two
# must not disagree; write a hard line break as a trailing backslash, which CommonMark also accepts and which
# survives trimming.

[*.bat]
end_of_line = crlf

[{*.kts,*.gradle}]
indent_size = 4

[*.py]
indent_size = 4
