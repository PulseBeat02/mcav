// How one pixel finds the leaf that covers it and the leaf's record in a derived-offsets frame: a bounded walk with no
// neighbour and no scan of the frame.
digraph leaf {
  rankdir=TB;
  bgcolor="white";
  pad=0.25;
  nodesep=0.4;
  ranksep=0.32;
  splines=ortho;
  node [shape=box, style="filled", fillcolor="#dae8fc", color="#6c8ebf", fontname="Liberation Sans", fontsize=12, fontcolor="black", margin="0.14,0.09", penwidth=1.2];
  edge [color="black", arrowsize=0.75, penwidth=1.0, fontname="Liberation Sans", fontsize=11, fontcolor="black"];

  pixel [label="Pixel (x, y)", fillcolor="#fff2cc", color="#d6b656"];
  root [label="Superblock r = (y / 32) x columns + x / 32"];
  present [shape=diamond, label="Bit r of the\npresence masks set?", fillcolor="#f8cecc", color="#b85450", margin="0.04,0.04"];
  skip [label="SKIP: the reference at the global vector\n(the default colour on a keyframe)", fillcolor="#d5e8d4", color="#82b366"];
  index [label="Descriptor index = directory checkpoint\n+ popcounts of at most 7 masks"];
  read [label="Read the descriptor (mode, q)"];
  split [shape=diamond, label="A split?", fillcolor="#f8cecc", color="#b85450", margin="0.04,0.04"];
  child [label="Child = n0 + 4 x (splits before it) + quadrant\n(walk checkpoint + at most 7 descriptors)"];
  record [label="Record offset = walk checkpoint's cursor\n+ the lengths of at most 7 records before it"];
  draw [label="Reconstruct the pixel from the record", fillcolor="#fff2cc", color="#d6b656"];

  pixel -> root -> present;
  present -> skip [xlabel="no"];
  present -> index [xlabel="yes"];
  index -> read -> split;
  split -> child [xlabel="yes"];
  child -> read [xlabel="at most twice"];
  split -> record [xlabel="no"];
  record -> draw;
}
