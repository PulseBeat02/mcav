// What the resource pack's post chain does on every rendered frame while a page frame is in view.
digraph decode {
  rankdir=TB;
  bgcolor="white";
  pad=0.25;
  nodesep=0.4;
  ranksep=0.3;
  splines=ortho;
  node [shape=box, style="filled", fillcolor="#d5e8d4", color="#82b366", fontname="Liberation Sans", fontsize=12, fontcolor="black", margin="0.14,0.09", penwidth=1.2];
  edge [color="black", arrowsize=0.75, penwidth=1.0, fontname="Liberation Sans", fontsize=11, fontcolor="black"];

  glow [label="A glowing page frame is drawn,\nso the outline post chain runs", fillcolor="#fff2cc", color="#d6b656"];
  pages [label="Read the strip back into bytes,\ncheck every page's CRC32"];
  decide [shape=diamond, label="A complete new frame\nwith its reference?", fillcolor="#f8cecc", color="#b85450", margin="0.04,0.04"];
  copy [label="Copy the last picture"];
  resolve [label="Resolve: one fragment\nper 8x8 cell finds its leaf"];
  decode [label="Decode: one fragment\nper pixel"];
  keep [label="Keep it in persistent targets\n(previous frame, last keyframe)"];
  screen [label="Ray-cast the wall onto the screen,\ndepth-tested against the world"];
  outline [label="Remove the page frames' glow"];
  shown [label="Picture on the wall", fillcolor="#fff2cc", color="#d6b656"];

  glow -> pages -> decide;
  decide -> copy [xlabel="no"];
  decide -> resolve [xlabel="yes"];
  resolve -> decode -> keep -> screen;
  copy -> screen;
  screen -> outline -> shown;
}
